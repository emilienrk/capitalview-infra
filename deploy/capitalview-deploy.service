[Unit]
Description=CapitalView pull-based deployment
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot

# --- ADAPT to your machine ---
# User that belongs to the docker group.
User=apstral
# Location where the capitalview-infra repo was cloned.
WorkingDirectory=/home/apstral/capitalview.fr
# age private key used by SOPS to decrypt .env.prod.enc.
Environment=SOPS_AGE_KEY_FILE=/home/apstral/.config/sops/age/keys.txt
ExecStart=/home/apstral/capitalview.fr/deploy/deploy.sh
# -----------------------------

# A deployment should never run forever.
TimeoutStartSec=600
